{
 "schema": "artifacts/1",
 "title": "Régie en direct",
 "defaultView": "direct",
 "page": {
  "nav": "none"
 },
 "data": {
  "stores": {
   "scene": {
    "initial": {
     "phase": "live",
     "titre": "Régie en direct",
     "soustitre": "En attente du signal…",
     "chapitre": "Avant-première",
     "reactions": 0,
     "annonces": 0,
     "fil0": "Le direct va commencer.",
     "fil1": "",
     "fil2": "",
     "param0": 0.15,
     "param1": 0.55,
     "param2": 0,
     "param3": 0.3
    },
    "reducer": "($t := $action.type;\n $p := $action.payload;\n $t = 'io:input' ? $merge([$state, {'titre': $p.titre ? $p.titre : $state.titre}]) : $t = 'chapitre' ? $merge([$state, {'chapitre': $p.nom, 'soustitre': $p.soustitre ? $p.soustitre : $state.soustitre}]) : $t = 'annonce' ? $merge([$state, {'fil0': $p.texte, 'fil1': $state.fil0, 'fil2': $state.fil1, 'annonces': $state.annonces + 1}]) : $t = 'reaction' ? $merge([$state, {'reactions': $state.reactions + ($p.n ? $p.n : 1)}]) : $t = 'finish' ? $merge([$state, {'phase': 'done'}]) : $state)",
    "budgetMs": 50
   }
  }
 },
 "views": [
  {
   "id": "direct",
   "title": "Direct",
   "root": {
    "nodes": [
     {
      "tagName": "div",
