 ],
 "io": {
  "title": "Régie en direct",
  "description": "Scène pilotée par flux : actions chapitre {nom, soustitre?}, annonce {texte}, reaction {n?}, finish ; partitions sur /param0 (énergie 0…1), /param1 (teinte 0…1), /param2 (flash 0…1), /param3 (densité 0…1) ; cartes ajoutées par document.patch dans #cartes (/views/0/root/nodes/2/nodes/-).",
  "modes": [
   "interactive",
   "embed"
  ],
  "input": {
   "schema": {
    "type": "object",
    "properties": {
     "titre": {
      "type": "string",
      "maxLength": 80
     }
    },
    "additionalProperties": false
   },
   "store": "scene"
  },
  "output": {
   "schema": {
    "type": "object",
    "properties": {
     "reactions": {
      "type": "integer"
     },
     "annonces": {
      "type": "integer"
     },
     "chapitre": {
      "type": "string"
     }
    }
   },
   "from": "scene",
   "when": "phase = 'done'"
  },
  "stream": {
   "store": "scene",
   "actions": {
    "chapitre": {
     "schema": {
      "type": "object",
      "properties": {
       "nom": {
        "type": "string",
        "maxLength": 40
       },
       "soustitre": {
        "type": "string",
        "maxLength": 120
       }
      },
      "required": [
       "nom"
      ]
     }
    },
    "annonce": {
     "schema": {
      "type": "object",
      "properties": {
       "texte": {
        "type": "string",
        "maxLength": 160
       }
      },
      "required": [
       "texte"
      ]
     }
    },
    "reaction": {
     "schema": {
      "type": "object",
      "properties": {
       "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
       }
      }
     }
    },
    "finish": {}
   },
   "state": true,
   "document": true,
   "score": true,
   "rate": 30
  }
 }
