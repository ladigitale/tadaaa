      },
      "nodes": [
       {
        "tagName": "sonic-shader",
        "attributes": {
         "params": "scene",
         "out-data-provider": "sceneShader",
         "image": "vec3 pal(float t){ return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67))); }\nfloat hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nfloat noise(vec2 p){ vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y); }\nfloat fbm(vec2 p){ float v = 0.0, a = 0.5; for (int k = 0; k < 5; k++) { v += a * noise(p); p *= 2.03; a *= 0.5; } return v; }\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 uv = f / iResolution.xy;\n  vec2 p = (2.0 * f - iResolution.xy) / iResolution.y;\n  float e = clamp(uParam0, 0.0, 1.0);\n  float t = iTime * (0.15 + 1.2 * e);\n  float d = mix(1.5, 4.0, clamp(uParam3, 0.0, 1.0));\n  vec3 col = vec3(0.02, 0.02, 0.05);\n  for (int k = 0; k < 3; k++) {\n    float fk = float(k);\n    float y = p.y + 0.35 * fk - 0.3 + 0.35 * fbm(vec2(p.x * d * 0.5 + t * 0.6 + fk * 3.1, t * 0.3 + fk));\n    float band = exp(-pow(y * (5.0 - 2.5 * e), 2.0));\n    col += band * pal(uParam1 + 0.12 * fk + 0.1 * fbm(p * 2.0 + t)) * (0.5 + 0.9 * e);\n  }\n  float stars = step(0.995, hash(floor(f * 0.5))) * (0.4 + 0.6 * sin(iTime * 3.0 + hash(floor(f)) * 6.28));\n  col += stars * 0.6 * (1.0 - e * 0.5);\n  col += uParam2 * pal(uParam1 + 0.5) * 0.8 * (1.0 - length(p) * 0.4);\n  col *= 1.0 - 0.35 * length(uv - 0.5);\n  o = vec4(col, 1.0);\n}\n",
         "dpr-max": "1.5",
         "play": true,
         "style": "position:absolute;inset:0;width:100%;height:100%;display:block"
        }
       },
