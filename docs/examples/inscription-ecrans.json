{
 "schema": "artifacts/1",
 "title": "Rejoignez la partie",
 "defaultView": "guichet",
 "page": {
  "nav": "none"
 },
 "data": {
  "stores": {
   "guichet": {
    "budgetMs": 50,
    "initial": {
     "phase": "live",
     "annonce": "",
     "manche": 1,
     "inscrits": [],
     "nombre": 0,
     "n": 0,
     "notice": null
    },
    "reducer": "(\n  $t := $action.type;\n  $p := $action.payload;\n  $n := $state.n + 1;\n  $t = 'inscrits'\n    ? $merge([$state, {\"inscrits\": $p.liste ? [$p.liste] : [], \"nombre\": $count($p.liste)}])\n  : $t = 'annonce'\n    ? $merge([$state, {\"annonce\": $p.texte, \"n\": $n, \"notice\": {\"text\": $p.texte, \"label\": \"Annonce\", \"status\": \"info\", \"n\": $n}}])\n  : $t = 'manche'\n    ? $merge([$state, {\"annonce\": \"Manche \" & $string($p.n) & \" : c'est parti !\", \"manche\": $p.n}])\n  : $t = 'fin'\n    ? $merge([$state, {\"annonce\": \"Partie terminée, merci !\", \"phase\": \"done\"}])\n  : $t = 'finish' ? $merge([$state, {\"phase\": \"done\"}])\n  : $state\n)"
   }
  }
 },
 "views": [
  {
   "id": "guichet",
   "title": "Inscription",
   "root": {
    "nodes": [
     {
      "tagName": "sonic-notify",
      "attributes": {
       "watch": "guichet.notice",
       "status": "info"
      }
     },
     {
      "tagName": "sonic-jsonata",
      "attributes": {
       "inputProvider": "guichet",
       "outputProvider": "inscrits",
       "expression": "$append([], $input.inscrits)"
      }
     },
     {
      "tagName": "div",
      "attributes": {
       "style": "max-width:80rem;margin:1.5rem auto;padding:0 1.5rem;display:grid;gap:1.5rem"
      },
      "nodes": [
       {
        "tagName": "div",
        "attributes": {
         "style": "display:flex;flex-wrap:wrap;gap:.5rem 2rem;align-items:baseline;justify-content:space-between"
        },
        "nodes": [
         {
          "tagName": "div",
          "attributes": {
           "style": "font-size:2.2rem;font-weight:800"
          },
          "textContent": "Rejoignez la partie"
         },
         {
          "tagName": "div",
          "attributes": {
           "style": "font-size:1.8rem;font-weight:700"
          },
          "nodes": [
           {
            "tagName": "sonic-value",
            "attributes": {
             "dataProvider": "guichet",
             "key": "annonce"
            }
           }
          ]
         }
        ]
       },
       {
        "tagName": "div",
        "attributes": {
         "style": "display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-around"
        },
        "nodes": [
         {
          "tagName": "div",
          "attributes": {
           "style": "display:grid;gap:.5rem;justify-items:center;text-align:center"
          },
          "nodes": [
           {
            "tagName": "div",
            "attributes": {
             "style": "font-size:1.6rem;font-weight:800;color:#e5262a"
            },
            "textContent": "Équipe rouge"
           },
           {
            "tagName": "sonic-qr",
            "attributes": {
             "text-from": "artifactRun.pairs.rouge.url",
             "ecc": "Q",
             "size": 240,
             "placeholder": "…",
             "label": "QR code : Équipe rouge"
            }
           },
           {
            "tagName": "div",
            "attributes": {
             "style": "font-size:1.05rem;font-variant-numeric:tabular-nums"
            },
            "nodes": [
             {
              "tagName": "sonic-value",
              "attributes": {
               "dataProvider": "artifactRun",
               "key": "pairs.rouge.code",
               "style": "font-weight:800;letter-spacing:.1em"
              }
             },
             {
              "tagName": "span",
              "textContent": " · "
             },
             {
              "tagName": "sonic-value",
              "attributes": {
               "dataProvider": "artifactRun",
               "key": "pairs.rouge.remaining",
               "style": "font-weight:800"
              }
             },
             {
              "tagName": "span",
              "textContent": " places"
             }
            ]
           }
          ]
         },
         {
          "tagName": "div",
          "attributes": {
           "style": "display:grid;gap:.5rem;justify-items:center;text-align:center"
          },
          "nodes": [
           {
            "tagName": "div",
            "attributes": {
             "style": "font-size:1.6rem;font-weight:800;color:#2563eb"
            },
            "textContent": "Équipe bleue"
           },
           {
            "tagName": "sonic-qr",
            "attributes": {
             "text-from": "artifactRun.pairs.bleu.url",
             "ecc": "Q",
             "size": 240,
             "placeholder": "…",
             "label": "QR code : Équipe bleue"
            }
           },
           {
            "tagName": "div",
            "attributes": {
             "style": "font-size:1.05rem;font-variant-numeric:tabular-nums"
            },
            "nodes": [
             {
              "tagName": "sonic-value",
              "attributes": {
               "dataProvider": "artifactRun",
               "key": "pairs.bleu.code",
               "style": "font-weight:800;letter-spacing:.1em"
              }
             },
             {
              "tagName": "span",
              "textContent": " · "
             },
             {
              "tagName": "sonic-value",
              "attributes": {
               "dataProvider": "artifactRun",
               "key": "pairs.bleu.remaining",
               "style": "font-weight:800"
              }
             },
             {
              "tagName": "span",
              "textContent": " places"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "tagName": "div",
        "attributes": {
         "style": "display:grid;gap:.6rem"
        },
        "nodes": [
         {
          "tagName": "div",
          "attributes": {
           "style": "font-size:1.3rem;font-weight:700"
          },
          "nodes": [
           {
            "tagName": "span",
            "textContent": "Inscrits : "
           },
           {
            "tagName": "sonic-value",
            "attributes": {
             "dataProvider": "guichet",
             "key": "nombre"
            }
           }
          ]
         },
         {
          "tagName": "div",
          "nodes": [
           {
            "tagName": "sonic-list",
            "attributes": {
             "dataProvider": "inscrits",
             "templateKey": "t",
             "displayContents": true
            },
            "nodes": [
             {
              "tagName": "template",
              "attributes": {
               "data-value": "rouge"
              },
              "nodes": [
               {
                "tagName": "div",
                "attributes": {
                 "style": "display:inline-block;margin:0 .4rem .4rem 0;padding:.35rem .8rem;border-radius:999px;background:#e5262a;color:#fff;font-weight:700;font-size:1.1rem"
                },
                "nodes": [
                 {
                  "tagName": "sonic-value",
                  "attributes": {
                   "key": "nom"
                  }
                 }
                ]
               }
              ]
             },
             {
              "tagName": "template",
              "attributes": {
               "data-value": "bleu"
              },
              "nodes": [
               {
                "tagName": "div",
                "attributes": {
                 "style": "display:inline-block;margin:0 .4rem .4rem 0;padding:.35rem .8rem;border-radius:999px;background:#2563eb;color:#fff;font-weight:700;font-size:1.1rem"
                },
                "nodes": [
                 {
                  "tagName": "sonic-value",
                  "attributes": {
                   "key": "nom"
                  }
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ],
 "io": {
  "title": "Rejoignez la partie",
  "description": "Écran d'inscription d'une régie (kit regie, paramètre guichet) : QR de ses équipes, inscrits, annonces.",
  "modes": [
   "interactive"
  ],
  "output": {
   "schema": {
    "type": "string"
   },
   "from": "guichet.annonce",
   "when": "phase = 'done'"
  },
  "stream": {
   "store": "guichet",
   "inscription": true,
   "actions": {
    "inscrits": {},
    "annonce": {
     "schema": {
      "type": "object",
      "properties": {
       "texte": {
        "type": "string"
       }
      }
     }
    },
    "manche": {},
    "fin": {},
    "finish": {}
   },
   "rate": 30
  }
 }
}
