# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMeToARandomSecretKey32chars
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost:8443
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in the DATABASE_URL env var
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Compose service host is "database". PHP outside Docker: 127.0.0.1 + published port (5433).
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5433/tada?serverVersion=16&charset=utf8"
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/tada?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> tadaaa ###
# 1 = register creates an active account + JWT (via .env.local in dev). Prod: 0.
REGISTRATION_AUTO_APPROVE=0
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
###< tadaaa ###

###> symfony/mercure-bundle ###
# Publish endpoint (server → hub). Subscribe URL for browsers (SPA → hub).
MERCURE_URL=http://127.0.0.1/.well-known/mercure
MERCURE_PUBLIC_URL=https://localhost:8443/.well-known/mercure
# Must match MERCURE_PUBLISHER_JWT_KEY / MERCURE_SUBSCRIBER_JWT_KEY in Compose / Caddy.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# 0 = skip subscribe credentials + publish (e.g. hub not running).
MERCURE_ENABLED=1
###< symfony/mercure-bundle ###

###> tadaaa/web-push ###
# Leave empty to disable server push. Generate: php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@tadaaa.app
###< tadaaa/web-push ###

###> symfony/mailer ###
# Local/prod: set real SMTP in .env.local or root .env (never commit secrets).
# Infomaniak example: smtp://user%40domain:url-encoded-pass@mail.infomaniak.com:587
MAILER_DSN=null://null
MAIL_FROM=app@tadaaa.space
###< symfony/mailer ###

###> tadaaa/google-calendar ###
# OAuth client from Google Cloud Console (Calendar API enabled).
# Redirect URI: {DEFAULT_URI}/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
###< tadaaa/google-calendar ###

###> tadaaa/quotas ###
# Front base URL for email verification links (no trailing slash).
APP_PUBLIC_URL=http://localhost:5173
# Free-tier storage (5 MiB). Per-user override: null=default, 0=unlimited.
DEFAULT_STORAGE_QUOTA_BYTES=5242880
# Shared monthly transfer budget (5 GiB), split across active users with floor/ceil.
GLOBAL_MONTHLY_TRANSFER_BYTES=5368709120
FLOOR_PER_USER_MONTH_BYTES=52428800
CEIL_PER_USER_MONTH_BYTES=524288000
FLOOR_PER_USER_DAY_BYTES=2097152
CEIL_PER_USER_DAY_BYTES=26214400
###< tadaaa/quotas ###
