{
 "id": "visite-xr",
 "title": "Visite XR",
 "description": "Pièce meublée (monde sonic-3d, catalogue de mobilier) visitable à l'écran, en VR ou en AR (sonic-xr, boutons selon l'appareil).",
 "use": "aménagement, maquette d'intérieur à visiter en casque",
 "params": {
  "type": "object",
  "required": [
   "title"
  ],
  "properties": {
   "title": {
    "type": "string",
    "maxLength": 120
   },
   "largeur": {
    "type": "number",
    "minimum": 1.5,
    "maximum": 20,
    "default": 4,
    "description": "m, le long du mur 0"
   },
   "profondeur": {
    "type": "number",
    "minimum": 1.5,
    "maximum": 20,
    "default": 3.5,
    "description": "m, le long du mur 1"
   },
   "hauteur": {
    "type": "number",
    "minimum": 2,
    "maximum": 5,
    "default": 2.5
   },
   "sol": {
    "type": "string",
    "enum": [
     "parquet",
     "chevron",
     "moquette",
     "carrelage",
     "beton",
     "lino",
     "dalles"
    ],
    "default": "parquet"
   },
   "murs": {
    "type": "string",
    "maxLength": 7,
    "default": "#f4f1ea",
    "description": "#rrggbb"
   },
   "ouvertures": {
    "type": "array",
    "default": [],
    "maxItems": 8,
    "items": {
     "type": "object",
     "required": [
      "type",
      "mur",
      "x"
     ],
     "properties": {
      "type": {
       "type": "string",
       "enum": [
        "porte",
        "fenetre"
       ]
      },
      "mur": {
       "type": "integer",
       "minimum": 0,
       "maximum": 3
      },
      "x": {
       "type": "number",
       "minimum": 0,
       "description": "m, du coin gauche du mur (vu de la pièce) au milieu"
      },
      "largeur": {
       "type": "number",
       "minimum": 0.3,
       "maximum": 5
      },
      "hauteur": {
       "type": "number",
       "minimum": 0.3,
       "maximum": 4
      },
      "allege": {
       "type": "number",
       "minimum": 0,
       "maximum": 3,
       "description": "bas de fenêtre"
      }
     }
    }
   },
   "meubles": {
    "type": "array",
    "default": [],
    "maxItems": 40,
    "items": {
     "type": "object",
     "required": [
      "modele"
     ],
     "properties": {
      "modele": {
       "type": "string",
       "enum": [
        "lit",
        "bureau",
        "table",
        "etagere",
        "armoire",
        "commode",
        "tapis",
        "coussin",
        "rideau",
        "lampadaire",
        "lampe",
        "suspension",
        "applique",
        "cadre",
        "plante"
       ]
      },
      "nom": {
       "type": "string",
       "maxLength": 24,
       "description": "pour poser dessus"
      },
      "mur": {
       "type": "integer",
       "minimum": 0,
       "maximum": 3,
       "description": "mur i : coins (0,0)→(largeur,0) pour 0, puis suivants"
      },
      "x": {
       "type": "number",
       "description": "m, le long du mur ou dans la pièce"
      },
      "z": {
       "type": "number",
       "description": "m, sans mur"
      },
      "h": {
       "type": "number",
       "minimum": 0,
       "maximum": 4,
       "description": "avec mur : accroché à cette hauteur"
      },
      "sur": {
       "type": "string",
       "maxLength": 24,
       "description": "nom d'un meuble, plafond ou plancher"
      },
      "rot": {
       "type": "number",
       "description": "degrés"
      },
      "params": {
       "type": "object",
       "description": "du catalogue, en m"
      }
     }
    }
   },
   "echelle": {
    "type": "number",
    "minimum": 0.02,
    "maximum": 1,
    "default": 1,
    "description": "XR : 1 réel, 0.1 maquette"
   }
  }
 },
 "document": {
  "schema": "artifacts/1",
  "title": {
   "$param": "title"
  },
  "capabilities": [
   "xr"
  ],
  "defaultView": "visite",
  "data": {
   "stores": {
    "visite": {
     "initial": {
      "monde": {
       "espace": {
        "contour": [
         [
          0,
          0
         ],
         [
          {
           "$param": "largeur"
          },
          0
         ],
         [
          {
           "$param": "largeur"
          },
          {
           "$param": "profondeur"
          }
         ],
         [
          0,
          {
           "$param": "profondeur"
          }
         ]
        ],
        "hauteur": {
         "$param": "hauteur"
        },
        "bords": [
         {
          "couleur": {
           "$param": "murs"
          }
         }
        ],
        "zones": [
         {
          "nom": "plancher",
          "revetement": {
           "$param": "sol"
          }
         }
        ],
        "plafond": true
       },
       "ouvertures": [
        {
         "$each": "ouvertures",
         "template": {
          "type": {
           "$item": "type"
          },
          "bord": {
           "$item": "mur"
          },
          "at": {
           "$item": "x"
          },
          "largeur": {
           "$if": ".largeur",
           "then": {
            "$item": "largeur"
           }
          },
          "hauteur": {
           "$if": ".hauteur",
           "then": {
            "$item": "hauteur"
           }
          },
          "allege": {
           "$if": ".allege",
           "then": {
            "$item": "allege"
           }
          }
         }
        }
       ],
       "place": [
        {
         "$each": "meubles",
         "template": {
          "model": {
           "$item": "modele"
          },
          "name": {
           "$if": ".nom",
           "then": {
            "$item": "nom"
           },
           "else": {
            "$text": "meuble{{#1}}"
           }
          },
          "on": {
           "$if": ".sur",
           "then": {
            "$item": "sur"
           },
           "else": {
            "$if": ".mur=0|1|2|3",
            "then": {
             "$if": ".h",
             "then": {
              "$text": "mur{{.mur}}"
             }
            },
            "else": "plancher"
           }
          },
          "against": {
           "$if": ".sur",
           "else": {
            "$if": ".mur=0|1|2|3",
            "then": {
             "$if": "!.h",
             "then": {
              "$text": "mur{{.mur}}"
             }
            }
           }
          },
          "at": {
           "$if": ".sur",
           "then": [
            {
             "$item": "x",
             "default": 0
            },
            {
             "$item": "z",
             "default": 0
            }
           ],
           "else": {
            "$if": ".mur=0|1|2|3",
            "then": {
             "$if": ".h",
             "then": [
              {
               "$item": "x",
               "default": 0
              },
              {
               "$item": "h"
              }
             ],
             "else": {
              "$item": "x",
              "default": 0
             }
            },
            "else": [
             {
              "$item": "x",
              "default": 0
             },
             {
              "$item": "z",
              "default": 0
             }
            ]
           }
          },
          "rot": {
           "$if": ".rot",
           "then": [
            0,
            {
             "$item": "rot"
            },
            0
           ]
          },
          "params": {
           "$if": ".params",
           "then": {
            "$item": "params"
           }
          }
         }
        }
       ]
      }
     },
     "reducer": "$state"
    }
   }
  },
  "views": [
   {
    "id": "visite",
    "title": {
     "$param": "title"
    },
    "root": {
     "nodes": [
      {
       "tagName": "div",
       "attributes": {
        "style": "display:flex;flex-direction:column;gap:.8rem;max-width:56rem;margin:1rem auto;padding:0 1rem"
       },
       "nodes": [
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "immersion",
          "reducer": "$action.type = 'entrer' ? $merge([$state, {'xr': {'enter': {'n': $state.xr.enter.n + 1, 'mode': $action.payload.mode}}}]) : $state",
          "initial": {
           "$json": {
            "xr": {
             "enter": {
              "n": 0,
              "mode": "vr"
             }
            }
           }
          }
         }
        },
        {
         "tagName": "h1",
         "attributes": {
          "style": "font-size:1.5rem;font-weight:700;margin:0;color:var(--sc-base-content)"
         },
         "textContent": {
          "$param": "title"
         }
        },
        {
         "tagName": "div",
         "attributes": {
          "style": "border-radius:.75rem;overflow:hidden;background:var(--sc-base-100,var(--sc-base));border:1px solid var(--sc-base-200,rgba(127,127,127,.25))"
         },
         "nodes": [
          {
           "tagName": "sonic-3d",
           "attributes": {
            "id": "scene",
            "dataProvider": "visite",
            "aspect-ratio": "1.6",
            "max-distance": "80",
            "style": "display:block;width:100%"
           }
          }
         ]
        },
        {
         "tagName": "sonic-xr",
         "attributes": {
          "id": "xr",
          "target": "scene",
          "control": "immersion.xr",
          "mode": "auto",
          "features": "hand-tracking",
          "scale": {
           "$param": "echelle"
          }
         }
        },
        {
         "tagName": "div",
         "attributes": {
          "style": "display:flex;flex-wrap:wrap;gap:.5rem;align-items:center"
         },
         "nodes": [
          {
           "tagName": "sonic-if",
           "attributes": {
            "dataProvider": "xrState",
            "key": "modes.vr",
            "truthy": true
           },
           "nodes": [
            {
             "tagName": "sonic-action",
             "attributes": {
              "target": "immersion",
              "type": "entrer",
              "payload": "{\"mode\":\"vr\"}"
             },
             "nodes": [
              {
               "tagName": "sonic-button",
               "attributes": {
                "type": "primary",
                "data-xr": "vr"
               },
               "nodes": [
                {
                 "tagName": "sonic-icon",
                 "attributes": {
                  "library": "iconoir",
                  "name": "vr-symbol",
                  "slot": "prefix"
                 }
                },
                {
                 "tagName": "span",
                 "attributes": {
                  "style": ""
                 },
                 "textContent": "Visiter en VR"
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "tagName": "sonic-if",
           "attributes": {
            "dataProvider": "xrState",
            "key": "modes.ar",
            "truthy": true
           },
           "nodes": [
            {
             "tagName": "sonic-action",
             "attributes": {
              "target": "immersion",
              "type": "entrer",
              "payload": "{\"mode\":\"ar\"}"
             },
             "nodes": [
              {
               "tagName": "sonic-button",
               "attributes": {
                "type": "default",
                "data-xr": "ar"
               },
               "nodes": [
                {
                 "tagName": "sonic-icon",
                 "attributes": {
                  "library": "iconoir",
                  "name": "ar-symbol",
                  "slot": "prefix"
                 }
                },
                {
                 "tagName": "span",
                 "attributes": {
                  "style": ""
                 },
                 "textContent": "Voir en réalité augmentée"
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "tagName": "sonic-if",
           "attributes": {
            "dataProvider": "xrState",
            "key": "status",
            "equals": "unsupported"
           },
           "nodes": [
            {
             "tagName": "sonic-badge",
             "attributes": {
              "type": "warning",
              "data-xr": "indisponible"
             },
             "textContent": "Pas de casque ni de réalité augmentée ici : visite à l'écran"
            }
           ]
          },
          {
           "tagName": "sonic-if",
           "attributes": {
            "dataProvider": "xrState",
            "key": "status",
            "equals": "denied"
           },
           "nodes": [
            {
             "tagName": "sonic-badge",
             "attributes": {
              "type": "danger"
             },
             "textContent": "Réalité virtuelle refusée par le navigateur"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   }
  ]
 }
}
