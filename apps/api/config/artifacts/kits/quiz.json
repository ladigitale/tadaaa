{
 "id": "quiz",
 "title": "Quiz",
 "description": "Quiz une question à la fois : écran d'accueil, réponses (2 à 6), correction et explication, score final.",
 "use": "QCM, vrai/faux, quiz chronométré ou de vitesse (timer + speed)",
 "params": {
  "type": "object",
  "required": [
   "title",
   "questions"
  ],
  "properties": {
   "title": {
    "type": "string",
    "maxLength": 120
   },
   "intro": {
    "type": "string",
    "maxLength": 400,
    "default": ""
   },
   "icon": {
    "type": "string",
    "maxLength": 60,
    "description": "icône iconoir à côté du titre (find_icons)"
   },
   "timer": {
    "type": "integer",
    "minimum": 0,
    "maximum": 120,
    "default": 0,
    "description": "secondes par question, 0 = sans chrono"
   },
   "speed": {
    "type": "boolean",
    "default": false,
    "description": "bonus de rapidité (avec timer)"
   },
   "explain": {
    "type": "boolean",
    "default": true,
    "description": "affiche explain après la réponse"
   },
   "questions": {
    "type": "array",
    "minItems": 1,
    "maxItems": 60,
    "items": {
     "type": "object",
     "required": [
      "question",
      "answers",
      "correct"
     ],
     "properties": {
      "question": {
       "type": "string",
       "maxLength": 300
      },
      "answers": {
       "type": "array",
       "minItems": 2,
       "maxItems": 6,
       "items": {
        "type": "string",
        "maxLength": 120
       }
      },
      "correct": {
       "type": "integer",
       "minimum": 0,
       "maximum": 5,
       "description": "index de la bonne réponse, depuis 0"
      },
      "explain": {
       "type": "string",
       "maxLength": 400
      }
     }
    }
   }
  }
 },
 "document": {
  "schema": "artifacts/1",
  "title": {
   "$param": "title"
  },
  "defaultView": "quiz",
  "views": [
   {
    "id": "quiz",
    "title": {
     "$param": "title"
    },
    "root": {
     "nodes": [
      {
       "tagName": "div",
       "attributes": {
        "style": "display:flex;flex-direction:column;gap:1rem;max-width:40rem;margin:1.5rem auto;padding:0 1rem"
       },
       "nodes": [
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "quiz",
          "initial": {
           "$json": {
            "cfg": {
             "title": {
              "$param": "title"
             },
             "intro": {
              "$param": "intro",
              "default": ""
             },
             "timer": {
              "$param": "timer"
             },
             "speed": {
              "$param": "speed"
             },
             "explain": {
              "$param": "explain"
             }
            },
            "questions": {
             "$param": "questions"
            },
            "txt": {
             "start": "Commencer",
             "next": "Suivant",
             "again": "Rejouer",
             "score": "Score",
             "points": "points",
             "goodAnswers": "bonnes réponses",
             "question": "question",
             "questions": "questions",
             "perQuestion": "par question",
             "right": "Bonne réponse !",
             "wrong": "Raté ! C'était :",
             "timeout": "Temps écoulé ! C'était :",
             "perfect": "Parfait, sans faute !",
             "good": "Bien joué !",
             "retry": "Tu feras mieux la prochaine fois."
            },
            "phase": "intro",
            "i": 0,
            "score": 0,
            "good": 0,
            "running": false,
            "cur": {},
            "ok": false,
            "ko": false,
            "bar": [],
            "left": 0,
            "secs": "",
            "msg": "",
            "explainText": "",
            "info": "",
            "final": "",
            "verdict": ""
           }
          },
          "reducer": "(\n  $s := $state; $a := $action; $t := $a.type;\n  $Q := $s.questions; $n := $count($Q);\n  $ticks := $s.cfg.timer * 10;\n  $bar := function($left) { $ticks > 0 ? $map([1..20], function($k) { $k <= $ceil(20 * $left / $ticks) ? 1 : 0 }) : [] };\n  $answerText := function($q) { $q.answers[$q.correct] };\n  $explain := function($q) { $s.cfg.explain and $q.explain ? $q.explain : \"\" };\n  $show := function($st, $i) { $merge([$st, {\n    \"phase\": \"play\", \"i\": $i,\n    \"cur\": $merge([$Q[$i], {\"num\": $string($i + 1) & \" / \" & $string($n)}]),\n    \"left\": $ticks, \"secs\": $string($s.cfg.timer) & \" s\", \"bar\": $bar($ticks),\n    \"running\": $ticks > 0, \"msg\": \"\", \"explainText\": \"\"\n  }]) };\n  $verdict := function($st) { (\n    $ratio := $n > 0 ? $st.good / $n : 0;\n    $ratio = 1 ? $s.txt.perfect : $ratio >= 0.6 ? $s.txt.good : $s.txt.retry\n  ) };\n  $t = \"init\" ? $merge([$s, {\n    \"phase\": \"intro\",\n    \"info\": $string($n) & \" \" & ($n > 1 ? $s.txt.questions : $s.txt.question) & ($s.cfg.timer > 0 ? \" · \" & $string($s.cfg.timer) & \" s \" & $s.txt.perQuestion : \"\")\n  }]) :\n  $t = \"start\" ? $show($merge([$s, {\"score\": 0, \"good\": 0}]), 0) :\n  $t = \"answer\" and $s.phase = \"play\" ? (\n    $ok := $a.payload.a = $s.cur.correct;\n    $bonus := $ok and $s.cfg.speed and $ticks > 0 ? $round(100 * $s.left / $ticks) : 0;\n    $pts := $ok ? 100 + $bonus : 0;\n    $merge([$s, {\n      \"phase\": \"feedback\", \"running\": false, \"ok\": $ok, \"ko\": $not($ok),\n      \"score\": $s.score + $pts, \"good\": $s.good + ($ok ? 1 : 0),\n      \"msg\": $ok ? $s.txt.right & ($bonus > 0 ? \" +\" & $string($pts) : \"\") : $s.txt.wrong & \" \" & $answerText($s.cur),\n      \"explainText\": $explain($s.cur)\n    }])\n  ) :\n  $t = \"tick\" and $s.phase = \"play\" ? (\n    $l := $s.left - 1;\n    $l <= 0\n      ? $merge([$s, {\"phase\": \"feedback\", \"running\": false, \"ok\": false, \"ko\": true, \"left\": 0, \"bar\": $bar(0), \"secs\": \"0 s\",\n          \"msg\": $s.txt.timeout & \" \" & $answerText($s.cur), \"explainText\": $explain($s.cur)}])\n      : $merge([$s, {\"left\": $l, \"bar\": $bar($l), \"secs\": $string($ceil($l / 10)) & \" s\"}])\n  ) :\n  $t = \"next\" and $s.phase = \"feedback\" ? (\n    $s.i + 1 < $n ? $show($s, $s.i + 1) : $merge([$s, {\n      \"phase\": \"end\", \"running\": false,\n      \"final\": $string($s.good) & \" / \" & $string($n),\n      \"verdict\": $verdict($s)\n    }])\n  ) :\n  $t = \"restart\" ? $merge([$s, {\"phase\": \"intro\", \"running\": false}]) :\n  $s\n)",
          "boot-action": "init",
          "budget-ms": "60"
         }
        },
        {
         "$if": "timer",
         "then": {
          "tagName": "sonic-ticker",
          "attributes": {
           "target": "quiz",
           "interval": "100",
           "running-key": "running"
          }
         }
        },
        {
         "tagName": "h1",
         "attributes": {
          "style": "font-size:1.6rem;font-weight:700;margin:0;display:flex;align-items:center;gap:.6rem"
