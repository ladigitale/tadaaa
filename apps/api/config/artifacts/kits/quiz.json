         "nodes": [
          {
           "$if": "icon",
           "then": {
            "tagName": "sonic-icon",
            "attributes": {
             "library": "iconoir",
             "name": {
              "$param": "icon"
             },
             "style": "opacity:.7"
            }
           }
          },
          {
           "tagName": "sonic-value",
           "attributes": {
            "dataProvider": "quiz",
            "key": "cfg.title"
           }
          }
         ]
        },
        {
