{
 "id": "shader",
 "title": "Scène shader",
 "description": "Shader GLSL plein cadre (format ShaderToy) avec jusqu'à 4 réglages (−/+, hasard, réinitialiser) reliés à uParam0…3, souris en option.",
 "use": "fond animé, visualiseur, art génératif, effet interactif ; preset plasma prêt à l'emploi",
 "params": {
  "type": "object",
  "required": [
   "title",
   "shader"
  ],
  "properties": {
   "preset": {
    "type": "string",
    "enum": [
     "plasma"
    ]
   },
   "title": {
    "type": "string",
    "maxLength": 120
   },
   "help": {
    "type": "string",
    "maxLength": 300
   },
   "shader": {
    "type": "string",
    "maxLength": 12000,
    "description": "GLSL ES 3 : void mainImage(out vec4 o, in vec2 f) ; iResolution, iTime, iMouse (z>0 si appui), uParam0…3 = réglages"
   },
   "controls": {
    "type": "array",
    "default": [],
    "maxItems": 4,
    "items": {
     "type": "object",
     "required": [
      "label",
      "min",
      "max",
      "step",
      "value"
     ],
     "properties": {
      "label": {
       "type": "string",
       "maxLength": 30
      },
      "min": {
       "type": "number"
      },
      "max": {
       "type": "number"
      },
      "step": {
       "type": "number"
      },
      "value": {
       "type": "number"
      }
     }
    }
   },
   "mouse": {
    "type": "boolean",
    "default": true
   },
   "aspect": {
    "type": "number",
    "minimum": 0.3,
    "maximum": 4,
    "default": 1.6,
    "description": "largeur / hauteur"
   }
  }
 },
 "presets": {
  "plasma": {
   "title": "Plasma",
   "help": "Clique ou touche l'image pour déplacer le centre des ondes.",
   "shader": "vec3 pal(float t){ return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67))); }\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 p = (2.0 * f - iResolution.xy) / min(iResolution.x, iResolution.y);\n  float t = iTime * uParam0;\n  float s = uParam1;\n  vec2 m = iMouse.z > 0.0 ? (2.0 * iMouse.xy - iResolution.xy) / min(iResolution.x, iResolution.y) : vec2(0.0);\n  float v = sin(p.x * s + t) + sin(p.y * s * 1.3 - t * 1.1)\n          + sin((p.x + p.y) * s * 0.7 + t * 0.7) + sin(length(p - m) * s * 1.6 - t * 1.4);\n  vec3 col = pal(uParam2 + v * 0.15);\n  col *= 0.75 + 0.25 * sin(v * 3.14159);\n  o = vec4(col, 1.0);\n}\n",
   "controls": [
    {
     "label": "Vitesse",
     "min": 0,
     "max": 3,
     "step": 0.25,
     "value": 1
    },
    {
     "label": "Échelle",
     "min": 1,
     "max": 12,
     "step": 1,
     "value": 4
    },
    {
     "label": "Teinte",
     "min": 0,
     "max": 1,
     "step": 0.05,
     "value": 0.6
    }
   ]
  }
 },
 "document": {
  "schema": "artifacts/1",
  "title": {
   "$param": "title"
  },
  "defaultView": "scene",
  "views": [
   {
    "id": "scene",
    "title": {
     "$param": "title"
    },
    "root": {
     "nodes": [
      {
       "tagName": "div",
       "attributes": {
        "style": "display:flex;flex-direction:column;gap:.8rem;max-width:44rem;margin:1rem auto;padding:0 1rem"
       },
       "nodes": [
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "sceneui",
          "reducer": "$state",
          "initial": {
           "$json": {
            "title": {
             "$param": "title"
            },
            "help": {
             "$param": "help",
             "default": ""
            },
            "controls": {
             "$param": "controls"
            },
            "txt": {
             "minus": "−",
             "plus": "+",
             "random": "Hasard",
             "reset": "Réinitialiser"
            }
           }
          }
         }
        },
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "scene",
          "boot-action": "init",
          "budget-ms": "40",
          "reducer": "(\n  $s := $state; $a := $action; $t := $a.type;\n  $C := $s.controls;\n  $key := function($k) { \"param\" & $string($k) };\n  $set := function($st, $k, $v) { (\n    $c := $C[$k];\n    $merge([$st, {$key($k): $round($clamp($v, $c.min, $c.max), 4)}])\n  ) };\n  $defaults := $reduce([0..($count($C) - 1)], function($acc, $k) { $merge([$acc, {$key($k): $C[$k].value}]) }, {});\n  $k := $a.payload.p;\n  $t = \"init\" or $t = \"reset\" ? $merge([$s, $count($C) > 0 ? $defaults : {}]) :\n  $t = \"inc\" and $k < $count($C) ? $set($s, $k, $lookup($s, $key($k)) + $C[$k].step) :\n  $t = \"dec\" and $k < $count($C) ? $set($s, $k, $lookup($s, $key($k)) - $C[$k].step) :\n  $t = \"random\" and $count($C) > 0 ? (\n    $r := $reduce([0..($count($C) - 1)], function($acc, $k) { (\n      $x := $rand($acc.seed);\n      $c := $C[$k];\n      $v := $c.min + $x.value * ($c.max - $c.min);\n      $q := $c.step > 0 ? $c.min + $round(($v - $c.min) / $c.step) * $c.step : $v;\n      {\"seed\": $x.seed, \"vals\": $merge([$acc.vals, {$key($k): $round($clamp($q, $c.min, $c.max), 4)}])}\n    ) }, {\"seed\": $s.seed, \"vals\": {}});\n    $merge([$s, $r.vals, {\"seed\": $r.seed}])\n  ) :\n  $s\n)",
          "initial": {
           "$json": {
            "controls": {
             "$param": "controls"
            },
            "seed": 2026,
            "param0": 0,
            "param1": 0,
            "param2": 0,
            "param3": 0
           }
          }
         }
        },
        {
         "tagName": "h1",
         "attributes": {
          "style": "font-size:1.5rem;font-weight:700;margin:0"
         },
         "nodes": [
          {
           "tagName": "sonic-value",
           "attributes": {
            "dataProvider": "sceneui",
            "key": "title"
           }
          }
         ]
        },
        {
         "tagName": "div",
         "attributes": {
          "style": "border-radius:1rem;overflow:hidden;background:#05050a;box-shadow:0 10px 40px rgba(0,0,0,.3)"
         },
         "nodes": [
          {
           "tagName": "sonic-shader",
           "attributes": {
            "dataProvider": "scene",
            "image": {
             "$param": "shader"
            },
            "aspect-ratio": {
             "$param": "aspect"
            },
            "dpr-max": "1.5",
            "play": true,
            "mouse": {
             "$param": "mouse"
            },
            "style": "display:block;width:100%"
           }
          }
         ]
        },
        {
         "tagName": "div",
         "attributes": {
          "style": "display:flex;flex-direction:column;gap:.45rem"
         },
         "nodes": [
          {
           "$each": "controls",
           "template": {
            "tagName": "div",
            "attributes": {
             "style": "display:grid;grid-template-columns:1fr 2.6rem 4rem 2.6rem;gap:.4rem;align-items:center",
             "data-control": {
              "$text": "{{#}}"
             }
            },
            "nodes": [
             {
              "tagName": "span",
              "attributes": {
               "style": "font-size:.9rem"
              },
              "nodes": [
               {
                "tagName": "sonic-value",
                "attributes": {
                 "dataProvider": "sceneui",
                 "key": {
                  "$text": "controls.{{#}}.label"
                 }
                }
               }
              ]
             },
             {
              "tagName": "sonic-action",
              "attributes": {
               "target": "scene",
               "type": "dec",
               "payload": {
                "$text": "{\"p\": {{#}}}"
               }
              },
              "nodes": [
               {
                "tagName": "sonic-button",
                "attributes": {
                 "variant": "outline",
                 "style": "width:100%",
                 "data-dec": {
                  "$text": "{{#}}"
                 },
                 "aria-label": "dec"
                },
                "nodes": [
                 {
                  "tagName": "sonic-icon",
                  "attributes": {
                   "library": "iconoir",
                   "name": "minus"
                  }
                 }
                ]
               }
              ]
             },
             {
              "tagName": "strong",
              "attributes": {
               "style": "text-align:center;font-variant-numeric:tabular-nums",
               "data-value": {
                "$text": "{{#}}"
               }
              },
              "nodes": [
               {
                "tagName": "sonic-value",
                "attributes": {
                 "dataProvider": "scene",
                 "key": {
                  "$text": "param{{#}}"
                 }
                }
               }
              ]
             },
             {
              "tagName": "sonic-action",
              "attributes": {
               "target": "scene",
               "type": "inc",
               "payload": {
                "$text": "{\"p\": {{#}}}"
               }
              },
              "nodes": [
               {
                "tagName": "sonic-button",
                "attributes": {
                 "variant": "outline",
                 "style": "width:100%",
                 "data-inc": {
                  "$text": "{{#}}"
                 },
                 "aria-label": "inc"
                },
                "nodes": [
                 {
                  "tagName": "sonic-icon",
                  "attributes": {
                   "library": "iconoir",
                   "name": "plus"
                  }
                 }
                ]
               }
              ]
             }
            ]
           }
          }
         ]
        },
        {
         "$if": "controls",
         "then": {
          "tagName": "div",
          "attributes": {
           "style": "display:grid;grid-template-columns:1fr 1fr;gap:.4rem"
          },
          "nodes": [
           {
            "tagName": "sonic-action",
            "attributes": {
             "target": "scene",
             "type": "random"
            },
            "nodes": [
             {
              "tagName": "sonic-button",
              "attributes": {
               "variant": "outline",
               "style": "width:100%",
               "data-random": ""
              },
              "nodes": [
               {
                "tagName": "sonic-icon",
                "attributes": {
                 "slot": "prefix",
                 "library": "iconoir",
                 "name": "shuffle"
                }
               },
               {
                "tagName": "sonic-value",
                "attributes": {
                 "dataProvider": "sceneui",
                 "key": "txt.random"
                }
               }
              ]
             }
            ]
           },
           {
            "tagName": "sonic-action",
            "attributes": {
             "target": "scene",
             "type": "reset"
            },
            "nodes": [
             {
              "tagName": "sonic-button",
              "attributes": {
               "variant": "outline",
               "style": "width:100%",
               "data-reset": ""
              },
              "nodes": [
               {
                "tagName": "sonic-icon",
                "attributes": {
                 "slot": "prefix",
                 "library": "iconoir",
                 "name": "refresh-double"
                }
               },
               {
                "tagName": "sonic-value",
                "attributes": {
                 "dataProvider": "sceneui",
                 "key": "txt.reset"
                }
               }
              ]
             }
            ]
           }
          ]
         }
        },
        {
         "$if": "help",
         "then": {
          "tagName": "p",
          "attributes": {
           "style": "margin:0;font-size:.85rem;opacity:.7"
          },
          "nodes": [
           {
            "tagName": "sonic-value",
            "attributes": {
             "dataProvider": "sceneui",
             "key": "help"
            }
           }
          ]
         }
        }
       ]
      }
     ]
    }
   }
  ]
 }
}