{
 "id": "direct",
 "title": "Scène en direct (flux)",
 "description": "Shader plein cadre dont les réglages (param0…3) et la légende se pilotent en direct par le flux d’un run (io.stream).",
 "use": "écran live, VJ, visualisation pilotée par un script, un capteur ou un agent ; run interactive / embed puis stream_artifact_events (ou POST stream.eventsUrl), stream.watchUrl pour les spectateurs",
 "params": {
  "type": "object",
  "required": [
   "title",
   "shader"
  ],
  "properties": {
   "preset": {
    "type": "string",
    "enum": [
     "plasma"
    ]
   },
   "title": {
    "type": "string",
    "maxLength": 120
   },
   "caption": {
    "type": "string",
    "maxLength": 300,
    "default": ""
   },
   "shader": {
    "type": "string",
    "maxLength": 12000,
    "description": "GLSL ES 3 : void mainImage(out vec4 o, in vec2 f) ; iResolution, iTime, iMouse, uParam0…3 = réglages pilotés par le flux"
   },
   "start": {
    "type": "array",
    "maxItems": 4,
    "default": [
     1,
     4,
     0.6,
     0
    ],
    "items": {
     "type": "number"
    },
    "description": "valeurs de départ de param0…3"
   },
   "aspect": {
    "type": "number",
    "minimum": 0.3,
    "maximum": 4,
    "default": 1.78
   }
  }
 },
 "document": {
  "schema": "artifacts/1",
  "title": {
   "$param": "title"
  },
  "defaultView": "scene",
  "views": [
   {
    "id": "scene",
    "title": {
     "$param": "title"
    },
    "root": {
     "nodes": [
      {
       "tagName": "div",
       "attributes": {
        "style": "display:flex;flex-direction:column;gap:.8rem;max-width:60rem;margin:1rem auto;padding:0 1rem"
       },
       "nodes": [
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "sceneui",
          "reducer": "$state",
          "initial": {
           "$json": {
            "title": {
             "$param": "title"
            }
           }
          }
         }
        },
        {
         "tagName": "sonic-store",
         "attributes": {
          "id": "scene",
          "budget-ms": "20",
          "reducer": "$action.type = 'set' ? $merge([$state, $action.payload]) : $action.type = 'finish' ? $merge([$state, {'phase': 'done'}]) : $state",
          "initial": {
           "$json": {
            "phase": "live",
            "param0": {
             "$param": "start.0",
             "default": 1
            },
            "param1": {
             "$param": "start.1",
             "default": 4
            },
            "param2": {
             "$param": "start.2",
             "default": 0.6
            },
            "param3": {
             "$param": "start.3",
             "default": 0
            }
           }
          }
         }
        },
        {
         "tagName": "h1",
         "attributes": {
          "style": "font-size:1.5rem;font-weight:700;margin:0"
         },
         "nodes": [
          {
           "tagName": "sonic-value",
           "attributes": {
            "dataProvider": "sceneui",
            "key": "title"
           }
          }
         ]
        },
        {
         "tagName": "div",
         "attributes": {
          "style": "border-radius:.75rem;overflow:hidden;background:#000;border:1px solid var(--sc-base-200,rgba(127,127,127,.25))"
         },
         "nodes": [
          {
           "tagName": "sonic-shader",
           "attributes": {
            "dataProvider": "scene",
            "image": {
             "$param": "shader"
            },
            "aspect-ratio": {
             "$param": "aspect"
            },
            "dpr-max": "1.5",
            "play": true,
            "style": "display:block;width:100%"
           }
          }
         ]
        },
        {
         "tagName": "p",
         "attributes": {
          "id": "legende",
          "style": "margin:0;color:var(--sc-base-content);opacity:.8"
         },
         "textContent": {
          "$param": "caption"
         }
        }
       ]
      }
     ]
    }
   }
  ],
  "io": {
   "title": {
    "$param": "title"
   },
   "description": "Scène pilotée en direct : param0…3 du shader (action set, state.delta, partitions sur /param0…/param3), légende (document.patch sur le texte de #legende). La sortie (réglages finaux) part à la fin du flux (end) ou sur l’action finish.",
   "modes": [
    "interactive",
    "embed"
   ],
   "input": {
    "schema": {
     "type": "object",
     "properties": {
      "param0": {
       "type": "number"
      },
      "param1": {
       "type": "number"
      },
      "param2": {
       "type": "number"
      },
      "param3": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    "store": "scene",
    "action": "set"
   },
   "output": {
    "schema": {
     "type": "object",
     "properties": {
      "param0": {
       "type": "number"
      },
      "param1": {
       "type": "number"
      },
      "param2": {
       "type": "number"
      },
      "param3": {
       "type": "number"
      }
     }
    },
    "from": "scene",
    "when": "phase = 'done'"
   },
   "stream": {
    "store": "scene",
    "actions": {
     "set": {
      "schema": {
       "type": "object",
       "properties": {
        "param0": {
         "type": "number"
        },
        "param1": {
         "type": "number"
        },
        "param2": {
         "type": "number"
        },
        "param3": {
         "type": "number"
        }
       },
       "additionalProperties": false
      },
      "description": "réglages param0…3"
     },
     "finish": {
      "description": "termine le run (sortie = réglages)"
     }
    },
    "state": true,
    "document": true,
    "score": true,
    "rate": 60
   }
  }
 },
 "presets": {
  "plasma": {
   "title": "Plasma en direct",
   "shader": "vec3 pal(float t){ return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67))); }\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 p = (2.0 * f - iResolution.xy) / min(iResolution.x, iResolution.y);\n  float t = iTime * uParam0;\n  float s = uParam1;\n  vec2 m = iMouse.z > 0.0 ? (2.0 * iMouse.xy - iResolution.xy) / min(iResolution.x, iResolution.y) : vec2(0.0);\n  float v = sin(p.x * s + t) + sin(p.y * s * 1.3 - t * 1.1)\n          + sin((p.x + p.y) * s * 0.7 + t * 0.7) + sin(length(p - m) * s * 1.6 - t * 1.4);\n  vec3 col = pal(uParam2 + v * 0.15);\n  col *= 0.75 + 0.25 * sin(v * 3.14159);\n  o = vec4(col, 1.0);\n}\n"
  }
 }
}