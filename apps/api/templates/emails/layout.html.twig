{# Mise en page commune des emails Tadaaa : tableau centré, styles en ligne (clients mail), lisible sans images. #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f1ec;color:#22232b;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f1ec;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
          <tr>
            <td style="padding:0 4px 16px;font-size:22px;font-weight:800;letter-spacing:-0.01em;color:#22232b;">Tadaaa</td>
          </tr>
          <tr>
            <td style="background:#ffffff;border:1px solid #e4e1d8;border-radius:16px;padding:32px 28px;">
              <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;font-weight:700;color:#22232b;">{{ heading }}</h1>
              {% for p in paragraphs %}
                <p style="margin:0 0 14px;font-size:16px;line-height:1.55;color:#33343d;">{{ p }}</p>
              {% endfor %}
              {% if quote %}
                <p style="margin:4px 0 18px;padding:12px 16px;border-left:3px solid #c9c4b6;background:#f8f7f3;font-size:15px;line-height:1.5;color:#33343d;white-space:pre-line;">{{ quote }}</p>
              {% endif %}
              {% if action_url %}
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:22px 0 8px;">
                  <tr>
                    <td style="border-radius:999px;background:#2b2f6b;">
                      <a href="{{ action_url }}" style="display:inline-block;padding:13px 26px;font-size:16px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">{{ action_label }}</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:16px 0 0;font-size:13px;line-height:1.5;color:#6b6c75;">Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br><a href="{{ action_url }}" style="color:#2b2f6b;word-break:break-all;">{{ action_url }}</a></p>
              {% endif %}
              {% if note %}
                <p style="margin:18px 0 0;font-size:14px;line-height:1.5;color:#6b6c75;">{{ note }}</p>
              {% endif %}
            </td>
          </tr>
          <tr>
            <td style="padding:18px 4px 0;font-size:12px;line-height:1.6;color:#7a7b84;">
              {{ footer }}<br>
              Tadaaa · <a href="{{ app_url }}" style="color:#7a7b84;">{{ app_host }}</a> · <a href="{{ app_url }}/legal/mentions" style="color:#7a7b84;">Mentions légales</a> · <a href="{{ app_url }}/legal/privacy" style="color:#7a7b84;">Confidentialité</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
