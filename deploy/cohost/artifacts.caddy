{$ARTIFACTS_SERVER_NAME:artifacts.example.com} {
	encode zstd gzip
	root * /artifacts
	# SPA : /slug et /slug/ → index.html (évite 404 / dossier fantôme)
	try_files {path} {path}/index.html /index.html
	file_server

	# Intégration sur d'autres sites : <script src="/embed.js" data-artifact="…">.
	# Le module (type=module), ses chunks, le worklet audio et les assets sont lus en CORS
	# depuis la page hôte. embed.js et artifact-embed.js n'ont pas de hash : cache court.
	@embed path /embed.js /embed/* /assets/*
	header @embed Access-Control-Allow-Origin "*"
	header @embed Cross-Origin-Resource-Policy cross-origin
	@embed_entry path /embed.js /embed/artifact-embed.js
	header @embed_entry Cache-Control "public, max-age=300"
	@embed_hashed path /embed/chunks/* /embed/assets/*
	header @embed_hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Caméra / micro : seulement pour l'origine du viewer (sonic-camera, sonic-mic),
		# et seulement si le document les déclare dans `capabilities` (garde du viewer).
		Permissions-Policy "camera=(self), microphone=(self), midi=(self), display-capture=(self), geolocation=(), payment=(), usb=(), browsing-topics=()"
		X-Frame-Options DENY
		# CSP: pas d'inline script / pas d'eval.
		# fonts.googleapis.com : thèmes Tadaaa (appearance).
		# cdn.jsdelivr.net : libs whitelist scripts-catalog + CSS associées.
		# connect-src https : API Tadaaa publique.
		# worker-src / wasm : three, tensorflow, onnx…
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob: data:; connect-src 'self' https: blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
