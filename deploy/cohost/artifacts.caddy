{$ARTIFACTS_SERVER_NAME:artifacts.example.com} {
	encode zstd gzip
	root * /artifacts
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "browsing-topics=()"
		X-Frame-Options DENY
		# CSP: pas d'inline script / pas d'eval.
		# fonts.googleapis.com : thèmes Tadaaa (appearance).
		# connect-src https : API Tadaaa publique.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
