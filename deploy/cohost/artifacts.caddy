{$ARTIFACTS_SERVER_NAME:artifacts.example.com} {
	encode zstd gzip
	root * /artifacts
	# SPA : /slug et /slug/ → index.html (évite 404 / dossier fantôme)
	try_files {path} {path}/index.html /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "browsing-topics=()"
		X-Frame-Options DENY
		# CSP: pas d'inline script / pas d'eval.
		# fonts.googleapis.com : thèmes Tadaaa (appearance).
		# cdn.jsdelivr.net : libs whitelist scripts-catalog + CSS associées.
		# connect-src https : API Tadaaa publique.
		# worker-src / wasm : three, tensorflow, onnx…
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob: data:; connect-src 'self' https: blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
