{$ARTIFACTS_SERVER_NAME:artifacts.example.com} {
	encode zstd gzip
	root * /artifacts
	# SPA : /, /admin…, /cloud…, /<slug> (même regex que l'API ; slug inconnu = 200, seul l'API le sait)
	@spa_route path_regexp ^/(?:|admin(?:/.*)?|cloud(?:/.*)?|[a-z0-9][a-z0-9-]{2,63}/?)$

	# Robots d'aperçu de liens (Slack, WhatsApp, Discord, X…, pas les moteurs de recherche qui exécutent le
	# viewer) : page de partage de l'API, avec titre, description et image de page de l'artefact (Open Graph).
	@share_bot {
		path_regexp share_slug ^/([a-z0-9][a-z0-9-]{2,63})/?$
		not path /admin /admin/ /cloud /cloud/ /demarrer /demarrer/
		header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|meta-externalagent|twitterbot|slackbot|discordbot|linkedinbot|whatsapp|telegrambot|skypeuripreview|pinterest|redditbot|embedly|iframely|mastodon|bluesky|cardyb|vkshare|viber|snapchat|google-pagerenderer|microsoftpreview)
	}
	handle @share_bot {
		rewrite * /api/public/artifacts/{re.share_slug.1}/share?{query}
		reverse_proxy tadaaa-php:80 {
			header_up Host {$API_SERVER_NAME:api.example.com}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$API_SERVER_NAME:api.example.com}
		}
	}

	import agent_ready

	# Intégration sur d'autres sites : <script src="/embed.js" data-artifact="…">.
	# Le module (type=module), ses chunks, le worklet audio et les assets sont lus en CORS
	# depuis la page hôte. embed.js et artifact-embed.js n'ont pas de hash : cache court.
	@embed path /embed.js /embed/* /assets/*
	header @embed Access-Control-Allow-Origin "*"
	header @embed Cross-Origin-Resource-Policy cross-origin
	@embed_entry path /embed.js /embed/artifact-embed.js
	header @embed_entry Cache-Control "public, max-age=300"
	@embed_hashed path /embed/chunks/* /embed/assets/*
	header @embed_hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Caméra / micro / MIDI / écran / Bluetooth / port série : seulement pour l'origine du viewer,
		# et seulement si le document les déclare dans `capabilities` (garde du viewer).
		Permissions-Policy "camera=(self), microphone=(self), midi=(self), display-capture=(self), bluetooth=(self), serial=(self), geolocation=(self), payment=(), usb=(), browsing-topics=()"
		X-Frame-Options DENY
		# CSP: pas d'inline script / pas d'eval.
		# fonts.googleapis.com : thèmes Tadaaa (appearance).
		# cdn.jsdelivr.net : libs whitelist scripts-catalog + CSS associées.
		# connect-src https : API Tadaaa publique.
		# worker-src / wasm : three, tensorflow, onnx…
		Content-Security-Policy "default-src 'self'; manifest-src 'self' https:; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob: data:; connect-src 'self' https: blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
