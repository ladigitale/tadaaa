{
	email {$ACME_EMAIL}
}

{$APP_SERVER_NAME:app.example.com} {
	encode zstd gzip
	root * /srv
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "browsing-topics=()"
	}
}

{$API_SERVER_NAME:api.example.com} {
	# Upstream is the `tadaaa-php` alias, not `php`: cohosted stacks joined to the
	# edge (Glane on `web`) also expose a `php` alias and would capture this traffic.
	# Mercure SSE: no compression, flush immediately
	@mercure path /.well-known/mercure*

	handle @mercure {
		# Les participants d'un salon publient directement sur le hub (jeton limité à leur topic) :
		# on borne la taille d'un message, le hub n'ayant ni limite ni quota propre.
		request_body {
			max_size {$MERCURE_MAX_PUBLISH_BYTES:65536}
		}
		reverse_proxy tadaaa-php:80 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Agent (SSE AG-UI) : pas de compression, flush immédiat.
	@agent path /api/agent/*
	handle @agent {
		reverse_proxy tadaaa-php:80 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy tadaaa-php:80 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}

# Optional sister apps (e.g. Glane) — empty dir is fine when not cohosting.
import /etc/caddy/cohost/*.caddy
